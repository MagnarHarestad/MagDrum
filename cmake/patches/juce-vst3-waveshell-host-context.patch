@@ -82,8 +82,15 @@ void VST3PluginFormatHeadless::findAllTypesForFile (OwnedArray<PluginDescription>& results,
         if (pluginFactory == nullptr)
             continue;
 
         VSTComSmartPtr host { new VST3HostContextHeadless(), IncrementRef::yes };
+
+        // Shell modules may rebuild their class list when the host context is set.
+        // Apply the context before the first factory enumeration to avoid stale indices.
+        VSTComSmartPtr<IPluginFactory3> factory3;
+        if (factory3.loadFrom (pluginFactory.get()))
+            factory3->setHostContext (host->getFUnknown());
+
         for (const auto& d : DescriptionLister::findDescriptionsSlow (*host, *pluginFactory, File (file)))
             results.add (new PluginDescription (d));
     }
 }
